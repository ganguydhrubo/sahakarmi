{
  "name": "sahkarmi",
  "productName": "Sahkarmi",
  "version": "0.2.1",
  "description": "Sahkarmi (सहकर्मी) — AI coworkers for Indian businesses. A local-first desktop app where each coworker has its own workspace, browser, memory and task queue.",
  "author": {
    "name": "Dhrubo Ganguly",
    "email": "gangulydhrubo@gmail.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganguydhrubo/sahakarmi.git"
  },
  "bugs": {
    "url": "https://github.com/ganguydhrubo/sahakarmi/issues"
  },
  "homepage": "https://github.com/ganguydhrubo/sahakarmi#readme",
  "keywords": [
    "ai-coworkers",
    "india",
    "local-first",
    "electron",
    "solidjs",
    "claude",
    "codex",
    "agents"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "dev:reset": "bun scripts/reset-dev-state.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:renderer",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:backend": "vitest run src/backend",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:codex": "bun scripts/codex-doctor.ts --strict",
    "test:filesystem": "bun scripts/filesystem-smoke.ts",
    "test:imagegen": "bun scripts/filesystem-smoke.ts --imagegen",
    "codex:doctor": "bun scripts/codex-doctor.ts",
    "release:preflight": "bun scripts/release-preflight.ts",
    "release:patch": "bun scripts/prepare-release.ts patch",
    "release:minor": "bun scripts/prepare-release.ts minor",
    "release:major": "bun scripts/prepare-release.ts major",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:browser && bun run build",
    "package": "bun run build && electron-builder --dir --mac --arm64 --config.mac.identity=null --config.mac.notarize=false",
    "verify:package": "bun scripts/verify-macos-package.ts",
    "package:verify": "bun run package && bun run verify:package",
    "package:win": "bun run build && electron-builder --dir --win --x64 --publish never",
    "verify:package:win": "bun scripts/verify-windows-package.ts",
    "package:win:verify": "bun run package:win && bun run verify:package:win",
    "dist:mac": "bun run build && electron-builder --mac --arm64 --config.mac.identity=null --config.mac.notarize=false",
    "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never",
    "dist:release": "bun run build && electron-builder --mac --arm64 --publish never",
    "dist:linux": "bun run build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.228",
    "electron-updater": "6.8.9",
    "solid-js": "1.9.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@electron/fuses": "1.8.0",
    "@fontsource/baloo-2": "5.2.7",
    "@fontsource/hind-siliguri": "5.2.7",
    "@fontsource/mukta": "5.2.8",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "22.20.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.10"
  },
  "contributors": [
    {
      "name": "Norbert Bodziony (original OpenBot author, Apache-2.0 upstream)"
    }
  ]
}
